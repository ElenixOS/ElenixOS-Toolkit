{
  "name": "elenixos-toolkit",
  "displayName": "ElenixOS-Toolkit",
  "description": "Development and debugging toolkit for ElenixOS",
  "version": "0.1.0",
  "publisher": "ElenixOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElenixOS/ElenixOS-Toolkit.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/ElenixOSToolkitLogo.png",
  "keywords": [
    "ElenixOS",
    "embedded",
    "embedded systems",
    "simulator",
    "debugger",
    "LVGL",
    "UART",
    "YMODEM",
    "serial port",
    "framebuffer",
    "WebSocket",
    "native simulator",
    "device development"
  ],
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebug",
		"onWebviewPanel:elenixosSimulator",
		"onCommand:elenixos-toolkit.openEshTerminal",
		"onCommand:elenixos-toolkit.switchEshTerminalPort"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "elenixos-toolkit.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "elenixos-toolkit.openSimulator",
        "title": "ElenixOS: Open Simulator"
      },
      {
        "command": "elenixos-toolkit.sendYModem",
        "title": "ElenixOS: Send File or Folder with YMODEM (UART)"
      },
      {
        "command": "elenixos-toolkit.toggleYModemPause",
        "title": "ElenixOS: Pause/Resume YMODEM Transfer",
        "enablement": "elenixosToolkit.ymodemActive"
      },
      {
        "command": "elenixos-toolkit.terminateYModem",
        "title": "ElenixOS: Terminate YMODEM Transfer",
        "enablement": "elenixosToolkit.ymodemActive"
      },
      {
        "command": "elenixos-toolkit.openEshTerminal",
        "title": "ElenixOS: Open ESH Terminal"
      },
      {
        "command": "elenixos-toolkit.switchEshTerminalPort",
        "title": "ElenixOS: Switch ESH Terminal Port"
      }
    ],
    "configuration": {
      "title": "ElenixOS Toolkit",
      "properties": {
        "elenixosToolkit.simulatorPath": {
          "type": "string",
          "description": "Optional path to the Native ElenixOS Simulator executable used by ElenixOS: Open Simulator."
        },
        "elenixosToolkit.uartBaudRate": {
          "type": "number",
          "default": 921600,
          "minimum": 1,
          "maximum": 4000000,
          "description": "Default UART baud rate used by the ElenixOS ESH Terminal and YMODEM transfer."
        },
        "elenixosToolkit.uartMemoryMode": {
          "type": "string",
          "enum": [
            "window",
            "persistent"
          ],
          "enumDescriptions": [
            "Remember the ESH Terminal UART only while this VS Code window is open.",
            "Remember the ESH Terminal UART across VS Code restarts and workspace reopenings."
          ],
          "default": "window",
          "description": "Controls how the ESH Terminal remembers the last successfully connected UART configuration."
        },
        "elenixosToolkit.ymodemWriteChunkSize": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Maximum bytes written at once for each YMODEM UART chunk. Use 0 for a receiver with adequate buffering or hardware flow control."
        },
        "elenixosToolkit.ymodemWriteChunkDelayMs": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Delay in milliseconds between YMODEM UART chunks. Set to 0 when chunk pacing is not needed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "test:ymodem": "npm run compile-tests && node --test out/test/ymodem.test.js",
    "benchmark:ymodem": "npm run compile-tests && node out/test/ymodem.benchmark.js",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
