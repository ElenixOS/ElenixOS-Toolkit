{
  "name": "elenixos-toolkit",
  "displayName": "ElenixOS-Toolkit",
  "description": "Development and debugging toolkit for ElenixOS",
  "version": "0.0.1",
  "publisher": "elenixos",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onDebug",
    "onWebviewPanel:elenixosSimulator"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "elenixos-toolkit.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "elenixos-toolkit.openSimulator",
        "title": "ElenixOS: Open Simulator"
      }
    ],
    "configuration": {
      "title": "ElenixOS Toolkit",
      "properties": {
        "elenixosToolkit.simulatorPath": {
          "type": "string",
          "description": "Optional path to the Native ElenixOS Simulator executable used by ElenixOS: Open Simulator."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
